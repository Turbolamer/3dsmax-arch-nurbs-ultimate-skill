    WAL_EL_134_C04.name = "WAL_EL_134_C04"
    cell_count = cell_count + 1
    local WAL_EL_137_C01 = Box width:(910 * __f_unit) length:(20 * __f_unit) height:(400 * __f_unit) pos:([655, 2190, 1200] * __f_unit)
    WAL_EL_137_C01.name = "WAL_EL_137_C01"
    cell_count = cell_count + 1
    local WAL_EL_137_C02 = Box width:(180 * __f_unit) length:(20 * __f_unit) height:(90 * __f_unit) pos:([1200, 2190, 1200] * __f_unit)
    WAL_EL_137_C02.name = "WAL_EL_137_C02"
    cell_count = cell_count + 1
    local WAL_EL_137_C03 = Box width:(180 * __f_unit) length:(20 * __f_unit) height:(130 * __f_unit) pos:([1200, 2190, 1470] * __f_unit)
    WAL_EL_137_C03.name = "WAL_EL_137_C03"
    cell_count = cell_count + 1
    local WAL_EL_137_C04 = Box width:(1310 * __f_unit) length:(20 * __f_unit) height:(400 * __f_unit) pos:([1945, 2190, 1200] * __f_unit)
    WAL_EL_137_C04.name = "WAL_EL_137_C04"
    cell_count = cell_count + 1
    local WAL_EL_142_C01 = Box width:(510 * __f_unit) length:(20 * __f_unit) height:(400 * __f_unit) pos:([855, 410, 1600] * __f_unit)
    WAL_EL_142_C01.name = "WAL_EL_142_C01"
    cell_count = cell_count + 1
    local WAL_EL_142_C02 = Box width:(180 * __f_unit) length:(20 * __f_unit) height:(90 * __f_unit) pos:([1200, 410, 1600] * __f_unit)
    WAL_EL_142_C02.name = "WAL_EL_142_C02"
    cell_count = cell_count + 1
    local WAL_EL_142_C03 = Box width:(180 * __f_unit) length:(20 * __f_unit) height:(130 * __f_unit) pos:([1200, 410, 1870] * __f_unit)
    WAL_EL_142_C03.name = "WAL_EL_142_C03"
    cell_count = cell_count + 1
    local WAL_EL_142_C04 = Box width:(910 * __f_unit) length:(20 * __f_unit) height:(400 * __f_unit) pos:([1745, 410, 1600] * __f_unit)
    WAL_EL_142_C04.name = "WAL_EL_142_C04"
    cell_count = cell_count + 1
    local WAL_EL_145_C01 = Box width:(910 * __f_unit) length:(20 * __f_unit) height:(400 * __f_unit) pos:([1055, 1990, 2000] * __f_unit)
    WAL_EL_145_C01.name = "WAL_EL_145_C01"
    cell_count = cell_count + 1
    local WAL_EL_145_C02 = Box width:(180 * __f_unit) length:(20 * __f_unit) height:(90 * __f_unit) pos:([1600, 1990, 2000] * __f_unit)
    WAL_EL_145_C02.name = "WAL_EL_145_C02"
    cell_count = cell_count + 1
    local WAL_EL_145_C03 = Box width:(180 * __f_unit) length:(20 * __f_unit) height:(130 * __f_unit) pos:([1600, 1990, 2270] * __f_unit)
    WAL_EL_145_C03.name = "WAL_EL_145_C03"
    cell_count = cell_count + 1
    local WAL_EL_145_C04 = Box width:(510 * __f_unit) length:(20 * __f_unit) height:(400 * __f_unit) pos:([1945, 1990, 2000] * __f_unit)
    WAL_EL_145_C04.name = "WAL_EL_145_C04"
    cell_count = cell_count + 1
    -- hosts come from massing.ms; refuse to run without them.
    local host_EL_126 = getNodeByName "EL_126"
    if host_EL_126 == undefined do ( throw "G-80: host EL_126 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_127 = getNodeByName "EL_127"
    if host_EL_127 == undefined do ( throw "G-80: host EL_127 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_128 = getNodeByName "EL_128"
    if host_EL_128 == undefined do ( throw "G-80: host EL_128 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_134 = getNodeByName "EL_134"
    if host_EL_134 == undefined do ( throw "G-80: host EL_134 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_137 = getNodeByName "EL_137"
    if host_EL_137 == undefined do ( throw "G-80: host EL_137 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_142 = getNodeByName "EL_142"
    if host_EL_142 == undefined do ( throw "G-80: host EL_142 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_145 = getNodeByName "EL_145"
    if host_EL_145 == undefined do ( throw "G-80: host EL_145 is absent; fileIn massing.ms before assembly.ms" )
    local host_nodes = #(host_EL_126, host_EL_127, host_EL_128, host_EL_134, host_EL_137, host_EL_142, host_EL_145)
    -- Mechanism A (A-CORRECT): deactivate / hide host wall nodes so discrete cells
    -- tile the facade and openings remain clear of solid host geometry.
    for host_node in host_nodes do host_node.isHidden = true
    -- G-80: the emitted census. It counts nodes FOUND IN THE SCENE, not iterations of
    -- a loop that ran: the previous version counted its own bookkeeping and reported 16
    -- committed cuts while the scene held zero modifiers. A counter cannot observe a
    -- failed attach, so this one observes the scene.
    local found_cells = 0
    for scene_node in objects do
    (
        if (substring scene_node.name 1 4) == "WAL_" do found_cells = found_cells + 1
    )
    if found_cells != 27 do ( throw "G-80: found " + (found_cells as string) + " cell nodes named WAL_*; assembly.json wall_cells[] declares 27" )
    if placed_count != 181 do ( throw "G-80: placed " + (placed_count as string) + " instances; assembly.json declares 181 placements[]" )
    if proto_count != 11 do ( throw "G-80: built " + (proto_count as string) + f' prototypes; assembly.json resolves 11 distinct component_id values' )
    -- G-81: this stage emits ZERO modifiers, which is the only safe stack. The hosts
    -- must therefore arrive with an empty stack; a non-empty one means another
    -- stage left something behind.
    local stray_modifiers = 0
    for host_node in host_nodes do stray_modifiers = stray_modifiers + host_node.modifiers.count
    if stray_modifiers != 0 do ( throw "G-81: hosts carry " + (stray_modifiers as string) + " modifier(s); assembly.ms attaches none, so their stacks must be empty" )
    true
)
mcpAssemblyBuild_stepped_tower()
