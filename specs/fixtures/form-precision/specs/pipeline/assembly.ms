    WAL_EL_021_C04.name = "WAL_EL_021_C04"
    cell_count = cell_count + 1
    -- hosts come from massing.ms; refuse to run without them.
    local host_EL_014 = getNodeByName "EL_014"
    if host_EL_014 == undefined do ( throw "G-80: host EL_014 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_015 = getNodeByName "EL_015"
    if host_EL_015 == undefined do ( throw "G-80: host EL_015 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_016 = getNodeByName "EL_016"
    if host_EL_016 == undefined do ( throw "G-80: host EL_016 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_017 = getNodeByName "EL_017"
    if host_EL_017 == undefined do ( throw "G-80: host EL_017 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_018 = getNodeByName "EL_018"
    if host_EL_018 == undefined do ( throw "G-80: host EL_018 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_019 = getNodeByName "EL_019"
    if host_EL_019 == undefined do ( throw "G-80: host EL_019 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_020 = getNodeByName "EL_020"
    if host_EL_020 == undefined do ( throw "G-80: host EL_020 is absent; fileIn massing.ms before assembly.ms" )
    local host_EL_021 = getNodeByName "EL_021"
    if host_EL_021 == undefined do ( throw "G-80: host EL_021 is absent; fileIn massing.ms before assembly.ms" )
    local host_nodes = #(host_EL_014, host_EL_015, host_EL_016, host_EL_017, host_EL_018, host_EL_019, host_EL_020, host_EL_021)
    -- Mechanism A (A-CORRECT): deactivate / hide host wall nodes so discrete cells
    -- tile the facade and openings remain clear of solid host geometry.
    for host_node in host_nodes do host_node.isHidden = true
    -- G-80: the emitted census. It counts nodes FOUND IN THE SCENE, not iterations of
    -- a loop that ran: the previous version counted its own bookkeeping and reported 16
    -- committed cuts while the scene held zero modifiers. A counter cannot observe a
    -- failed attach, so this one observes the scene.
    local found_cells = 0
    for scene_node in objects do
    (
        if (substring scene_node.name 1 4) == "WAL_" do found_cells = found_cells + 1
    )
    if found_cells != 52 do ( throw "G-80: found " + (found_cells as string) + " cell nodes named WAL_*; assembly.json wall_cells[] declares 52" )
    if placed_count != 136 do ( throw "G-80: placed " + (placed_count as string) + " instances; assembly.json declares 136 placements[]" )
    if proto_count != 29 do ( throw "G-80: built " + (proto_count as string) + f' prototypes; assembly.json resolves 29 distinct component_id values' )
    -- G-81: this stage emits ZERO modifiers, which is the only safe stack. The hosts
    -- must therefore arrive with an empty stack; a non-empty one means another
    -- stage left something behind.
    local stray_modifiers = 0
    for host_node in host_nodes do stray_modifiers = stray_modifiers + host_node.modifiers.count
    if stray_modifiers != 0 do ( throw "G-81: hosts carry " + (stray_modifiers as string) + " modifier(s); assembly.ms attaches none, so their stacks must be empty" )
    true
)
